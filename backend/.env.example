# Django Settings
DJANGO_SECRET_KEY=plaans-dev-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=plaans_db

# Firebase Admin SDK (Optional in local dev; path to serviceAccountKey.json)
FIREBASE_CREDENTIALS_JSON=
FIREBASE_STORAGE_BUCKET=
